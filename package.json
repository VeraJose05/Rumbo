{
  "name": "rumbo",
  "version": "0.1.0",
  "description": "Planificador turístico conversacional con RAG y modelos open source (Genkit + Ollama).",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "npm run build && genkit start -- node --env-file-if-exists=.env dist/index.js",
    "flow:prueba": "npm run build && node --env-file-if-exists=.env dist/probar.js",
    "experimento:similitud": "npm run build && node --env-file-if-exists=.env dist/experimentos/similitud.js",
    "experimento:cobertura": "npm run build && node --env-file-if-exists=.env dist/experimentos/cobertura.js",
    "ingesta": "npm run build && node --env-file-if-exists=.env dist/ingest/indexar.js",
    "consulta": "npm run build && node --env-file-if-exists=.env dist/experimentos/consulta.js",
    "comparar": "npm run build && node --env-file-if-exists=.env dist/experimentos/comparar.js",
    "entrevista": "npm run build && node --env-file-if-exists=.env dist/experimentos/entrevista.js",
    "planificar": "npm run build && node --env-file-if-exists=.env dist/experimentos/planificar.js",
    "api": "npm run build && node --env-file-if-exists=.env dist/servidor.js",
    "evaluar": "npm run build && node --env-file-if-exists=.env dist/eval/evaluar.js",
    "evaluar:entrevista": "npm run build && node --env-file-if-exists=.env dist/eval/evaluar-entrevista.js",
    "recalcular": "npm run build && node --env-file-if-exists=.env dist/eval/recalcular.js",
    "juzgar": "npm run build && node --env-file-if-exists=.env dist/eval/juzgar.js",
    "tabla": "npm run build && node --env-file-if-exists=.env dist/eval/mostrar-tabla.js"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node": "24.19.2",
    "genkit-cli": "1.44.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@genkit-ai/express": "1.42.0",
    "chromadb": "3.5.0",
    "express": "4.22.3",
    "genkit": "1.42.0",
    "genkitx-ollama": "1.42.0"
  }
}
