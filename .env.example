# Configuración de modelos (RF-08). Copiar a .env y ajustar; todas son opcionales.
RUMBO_LLM=qwen2.5:3b
# LLM remoto compatible con OpenAI (RNF-10, despliegue). Vacío = Ollama.
# Con Groq: RUMBO_LLM=openai/gpt-oss-120b y RUMBO_LLM_URL=https://api.groq.com/openai/v1
RUMBO_LLM_URL=
# Clave del proveedor: solo en .env (ignorado por git) o en los secretos del hosting
RUMBO_LLM_CLAVE=
# Modelo que puntúa los itinerarios en la evaluación (npm run juzgar)
RUMBO_JUEZ=gemma2:9b
RUMBO_EMBEDDER=bge-m3
RUMBO_EMBEDDER_DIMENSIONES=1024
OLLAMA_URL=http://127.0.0.1:11434
# Ventana de contexto del LLM en tokens (Ollama recorta en silencio lo que no cabe)
RUMBO_CONTEXTO=8192
# Reranker de C2 (docker compose up -d reranker); el modelo se cambia también en docker-compose.yml
RUMBO_RERANKER=BAAI/bge-reranker-v2-m3
RERANKER_URL=http://127.0.0.1:8080

# Base vectorial (docker compose up -d)
CHROMA_URL=http://localhost:8000
CHROMA_COLECCION=destinos
