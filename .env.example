# Configuración de modelos (RF-08). Copiar a .env y ajustar; todas son opcionales.
RUMBO_LLM=qwen2.5:3b
RUMBO_EMBEDDER=bge-m3
RUMBO_EMBEDDER_DIMENSIONES=1024
OLLAMA_URL=http://127.0.0.1:11434
# Ventana de contexto del LLM en tokens (Ollama recorta en silencio lo que no cabe)
RUMBO_CONTEXTO=8192

# Base vectorial (docker compose up -d)
CHROMA_URL=http://localhost:8000
CHROMA_COLECCION=destinos
